; mod_TextExpander.ahk
; กด J สองครั้งติดกันเร็ว ๆ (double-press) แล้ววาง template สำหรับให้ AI (ChatGPT/Claude ฯลฯ)
; ช่วยแปลข้อความไทยเป็นภาษาญี่ปุ่นแบบง่าย สุภาพ ใช้ตอบรุ่นพี่ที่ทำงาน
; ผู้ใช้พิมพ์ข้อความไทยแทนที่ 「……」 เองแล้วค่อยเอาไปวางใน AI ที่ใช้อยู่ - ไม่มีการเรียก
; แปลภาษา/AI จากในสคริปต์เอง (โปรเจกต์นี้ยังไม่มี API key/บริการแปลภาษาผูกไว้เลย)
;
; ทำไมเปลี่ยนจาก hotstring "jj" (ตัวอักษร) มาเป็น scan code ตรง ๆ: hotstring/hotkey แบบตัวอักษร
; (j::) ต้องอาศัย keyboard layout ที่ active อยู่แปลตำแหน่งปุ่มเป็นตัวอักษร 'j' ก่อน AHK ถึงจะรู้จำ
; ได้ - ถ้าเปลี่ยนภาษาที่ใช้พิมพ์เป็นไทย ตำแหน่งปุ่มเดียวกันจะแปลออกมาเป็นอักษรไทยแทน ทำให้ AHK
; หาปุ่มที่ตรงกับตัวอักษร 'j' ไม่เจอเลย (ปัญหาเดียวกับที่เคยเจอกับ Alt+U ใน mod_AcrobatAVPopupHotkeys.ahk
; ต่างกันแค่คนละกลไก) ผู้ใช้ยืนยันว่าต้องใช้ได้ "ภาษาไม่เกี่ยวข้อง" จึงเปลี่ยนมาผูกกับ scan code
; ของตำแหน่งปุ่ม J บนคีย์บอร์ดจริง (SC024) แทน ซึ่งเป็นตำแหน่งกายภาพของปุ่ม ไม่ขึ้นกับ keyboard
; layout ที่ active อยู่เลย (เทคนิคเดียวกับที่ SC019/SC002 ใน mod_AcrobatAVPopupHotkeys.ahk ใช้อยู่
; แล้วสำหรับปัญหาแบบเดียวกัน)
;
; ใช้ deferred double-press state machine แบบเดียวกับ SC019/SC002: กดครั้งแรกยังไม่ทำอะไร แค่รอดู
; ก่อน (SetTimer) - ถ้ากดครบ 2 ครั้งภายในเวลาที่กำหนด ให้วาง template ทันทีโดยไม่พิมพ์ "j" ออกไป
; เลยแม้แต่ตัวเดียว - ถ้าหมดเวลาแล้วกดแค่ 1 ครั้ง ให้คืนพฤติกรรมเดิมคือพิมพ์ตัวอักษร "j" ตามปกติ
; (ด้วย scan code ตรง ๆ ให้ modifier เช่น Shift ทำงานตามจริงเหมือนไม่เคยถูกดักเลย)
;
; วาง template ผ่าน clipboard (Ctrl+V) แทนการพิมพ์ทีละตัวอักษร เพราะ template มีหลายบรรทัด ถ้าพิมพ์
; ตรง ๆ ต้องส่ง Enter จริงคั่นระหว่างบรรทัด ซึ่งในแอปแชท (Teams/LINE/Chatwork ฯลฯ) การกด Enter มัก
; หมายถึง "ส่งข้อความ" ทันที จะทำให้ template ถูกแบ่งส่งเป็นหลายข้อความครึ่ง ๆ กลาง ๆ โดยไม่ตั้งใจ -
; การวางผ่าน clipboard ใส่ตัวขึ้นบรรทัดใหม่เข้าไปในกล่องข้อความโดยตรง ไม่ผ่านการกด Enter จริงเลย
;
; ไม่ผูก #HotIf เพราะต้องใช้ได้ทุกที่ที่พิมพ์ข้อความได้ (Teams, LINE, Outlook, เว็บเบราว์เซอร์ ฯลฯ)
global g_JJ_Count := 0
global g_JJ_PressSeq := 0
JJ_WINDOW_MS := 400

SC024_HandlePress() {
    global g_JJ_Count, g_JJ_PressSeq

    g_JJ_Count += 1
    g_JJ_PressSeq += 1
    mySeq := g_JJ_PressSeq

    if (g_JJ_Count >= 2) {
        g_JJ_Count := 0
        JJ_Expand()
        return
    }

    SetTimer(SC024_Timeout.Bind(mySeq), -JJ_WINDOW_MS)
}

SC024_Timeout(mySeq) {
    global g_JJ_Count, g_JJ_PressSeq

    if (mySeq != g_JJ_PressSeq)
        return  ; มีการกดครั้งใหม่มาแทนที่ก่อนหมดเวลา ปล่อยให้ timer ของครั้งใหม่จัดการแทน

    g_JJ_Count := 0
    Send("{sc024}")  ; กดแค่ 1 ครั้ง - คืนพฤติกรรมเดิมคือพิมพ์ "j" ตามปกติ
}

JJ_Expand(*) {
    static template := "
    (
แปลเป็นภาษาญี่ปุ่นง่าย ๆ สำหรับใช้ตอบรุ่นพี่ที่ทำงาน
ขอรูปแบบ:

1. ประโยคญี่ปุ่นที่เป็นธรรมชาติ
2. คำอ่านฮิรางานะ
3. ความหมายภาษาไทย
4. แบบสั้นมากสำหรับจำไปตอบ
5. คำศัพท์สำคัญ พร้อมคำอ่านและความหมาย

เน้นภาษาง่าย สุภาพ และใช้ได้จริงในที่ทำงาน
ข้อความไทย: 「……」
    )"

    ; เก็บ clipboard เดิมของผู้ใช้ไว้ก่อน แล้ววางกลับคืนหลัง paste เสร็จ กันไม่ให้ทับของที่
    ; ผู้ใช้ copy ไว้ก่อนหน้าโดยไม่ตั้งใจ
    oldClip := ClipboardAll()

    A_Clipboard := template
    if !ClipWait(1) {
        A_Clipboard := oldClip
        return
    }

    Send("^v")
    Sleep(200)  ; กันกรณีแอปปลายทาง paste ช้ากว่าปกติ ก่อนจะคืน clipboard เดิมทับ

    A_Clipboard := oldClip
}

SC024:: SC024_HandlePress()
