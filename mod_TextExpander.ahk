; mod_TextExpander.ahk
; กด J หรือ M สองครั้งติดกันเร็ว ๆ (double-press) แล้ววาง prompt template ยาว ๆ ผ่าน clipboard
; - J สองครั้ง: template สำหรับให้ AI ช่วยแปลข้อความไทยเป็นภาษาญี่ปุ่นแบบง่าย สุภาพ ใช้ตอบรุ่นพี่
;   ที่ทำงาน (ผู้ใช้พิมพ์ข้อความไทยแทนที่ 「……」 เอง)
; - M สองครั้ง: system prompt สำหรับให้ AI ทำหน้าที่ผู้ช่วยเขียนอีเมลภาษาญี่ปุ่นในที่ทำงาน
; ทั้งสองแบบแค่วาง prompt boilerplate ให้เท่านั้น - ไม่มีการเรียกแปลภาษา/AI จากในสคริปต์เอง
; (โปรเจกต์นี้ยังไม่มี API key/บริการ AI ผูกไว้เลย) ผู้ใช้เอาไปวางต่อใน AI ที่ใช้อยู่เอง
;
; ทำไมผูกกับ scan code (SC024/SC032) แทนตัวอักษร j/m ตรง ๆ: hotstring/hotkey แบบตัวอักษรต้อง
; อาศัย keyboard layout ที่ active อยู่แปลตำแหน่งปุ่มเป็นตัวอักษรก่อน AHK ถึงจะรู้จำได้ - ถ้าเปลี่ยน
; ภาษาที่ใช้พิมพ์เป็นไทย ตำแหน่งปุ่มเดียวกันจะแปลออกมาเป็นอักษรไทยแทน ทำให้ AHK หาปุ่มที่ตรงกับ
; ตัวอักษรภาษาอังกฤษไม่เจอเลย (ปัญหาเดียวกับที่เคยเจอกับ Alt+U ใน mod_AcrobatAVPopupHotkeys.ahk
; ต่างกันแค่คนละกลไก - ที่นี่คือ hotstring/hotkey character matching) scan code คือตำแหน่งกายภาพ
; ของปุ่ม ไม่ขึ้นกับ keyboard layout ที่ active อยู่เลย จึงใช้ได้ "ภาษาไม่เกี่ยวข้อง" ตามที่ต้องการ
;
; ใช้ deferred double-press state machine แบบเดียวกับ SC019/SC002 ใน mod_AcrobatAVPopupHotkeys.ahk:
; กดครั้งแรกยังไม่ทำอะไร แค่รอดูก่อน (SetTimer) - ถ้ากดครบ 2 ครั้งภายในเวลาที่กำหนด ให้วาง template
; ทันทีโดยไม่พิมพ์ตัวอักษรที่กดออกไปเลยแม้แต่ตัวเดียว - ถ้าหมดเวลาแล้วกดแค่ 1 ครั้ง ให้คืนพฤติกรรม
; เดิมคือพิมพ์ตัวอักษรนั้นตามปกติ (ด้วย scan code ตรง ๆ ให้ modifier เช่น Shift ทำงานตามจริง)
; แยก state (count/seq) เป็นรายปุ่ม เพราะกดปุ่มหนึ่งไม่ควรไปนับรวมกับอีกปุ่ม
;
; วาง template ผ่าน clipboard (Ctrl+V) แทนการพิมพ์ทีละตัวอักษร เพราะ template มีหลายบรรทัด ถ้าพิมพ์
; ตรง ๆ ต้องส่ง Enter จริงคั่นระหว่างบรรทัด ซึ่งในแอปแชท (Teams/LINE/Chatwork ฯลฯ) การกด Enter มัก
; หมายถึง "ส่งข้อความ" ทันที จะทำให้ template ถูกแบ่งส่งเป็นหลายข้อความครึ่ง ๆ กลาง ๆ โดยไม่ตั้งใจ -
; การวางผ่าน clipboard ใส่ตัวขึ้นบรรทัดใหม่เข้าไปในกล่องข้อความโดยตรง ไม่ผ่านการกด Enter จริงเลย
;
; ไม่ผูก #HotIf เพราะต้องใช้ได้ทุกที่ที่พิมพ์ข้อความได้ (Teams, LINE, Outlook, เว็บเบราว์เซอร์ ฯลฯ)

; ============================================
; ENGINE (ใช้ร่วมกันทุกปุ่ม)
; ============================================

; ค่าดีเลย์ JJ_MM_WINDOW_MS (ใช้ร่วมกันทั้ง J และ M) ย้ายไปรวมไว้ที่ mod_HotkeyTiming.ahk แล้ว

DoublePressPaste_Handle(stateObj, scanCodeStr, template) {
    global JJ_MM_WINDOW_MS
    stateObj.count += 1
    stateObj.seq += 1
    mySeq := stateObj.seq

    if (stateObj.count >= 2) {
        stateObj.count := 0
        PasteTemplate(template)
        return
    }

    SetTimer(DoublePressPaste_Timeout.Bind(stateObj, scanCodeStr, mySeq), -JJ_MM_WINDOW_MS)
}

DoublePressPaste_Timeout(stateObj, scanCodeStr, mySeq) {
    if (mySeq != stateObj.seq)
        return  ; มีการกดครั้งใหม่มาแทนที่ก่อนหมดเวลา ปล่อยให้ timer ของครั้งใหม่จัดการแทน

    stateObj.count := 0
    Send("{" scanCodeStr "}")  ; กดแค่ 1 ครั้ง - คืนพฤติกรรมเดิมคือพิมพ์ตัวอักษรนั้นตามปกติ
}

PasteTemplate(template) {
    ; เก็บ clipboard เดิมของผู้ใช้ไว้ก่อน แล้ววางกลับคืนหลัง paste เสร็จ กันไม่ให้ทับของที่
    ; ผู้ใช้ copy ไว้ก่อนหน้าโดยไม่ตั้งใจ
    oldClip := ClipboardAll()

    A_Clipboard := template
    if !ClipWait(1) {
        A_Clipboard := oldClip
        return
    }

    Send("^v")
    Sleep(200)  ; กันกรณีแอปปลายทาง paste ช้ากว่าปกติ ก่อนจะคืน clipboard เดิมทับ

    A_Clipboard := oldClip
}

